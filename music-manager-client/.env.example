# ==============================================================================
# MUSIC MANAGER CONFIGURATION
# ==============================================================================

# 1. Container Image (Hosted on GitHub Container Registry)
IMAGE_NAME=ghcr.io/jb155/music-manager:latest

# 2. Web UI Port (Access the app in your browser at http://localhost:8085 or http://<server-ip>:8085)
PORT=8085

# 3. Path to your existing Music Library folder on your host machine or NAS
# Linux / Synology / OMV / TrueNAS example: /volume1/Music or /srv/storage/Music
# Windows Docker Desktop example: C:/Music or D:/Media/Music
MUSIC_PATH=/path/to/your/Music

# 4. Path to your staging / downloads directory (where downloads land before being tagged & moved)
NEW_MUSIC_PATH=/path/to/your/Music_New

# 5. Persistent config directory (stores your personal Beets library.db database)
CONFIG_PATH=./config

# 6. Audio preview cache directory
PREVIEW_PATH=./.music_preview

# 7. (Optional) Ollama Host for AI Music Recommendations & Smart Playlist Curation
# Leave blank if you do not run a local Ollama AI server
OLLAMA_HOST=
OLLAMA_MODEL=qwen3.5:9b
