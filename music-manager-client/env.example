# ================================================================
# Music Manager Configuration
# ================================================================

# [BASE STORAGE LOCATION]
# Declare the root folder where all music data will be stored.
# The system will automatically create and organize:
#   ├── music/          (Organized library: Artist/Album/Track)
#   ├── music_new/      (Staging area for incoming downloads)
#   ├── config/beets/   (Beets database and settings)
#   └── .music_preview/ (Audio preview cache)
#
# Examples:
#   Linux / NAS: STORAGE_PATH=/volume1/MusicData  or  /srv/music_data
#   Windows:     STORAGE_PATH=D:\MusicManagerData
#   Default:     STORAGE_PATH=./music_data
STORAGE_PATH=./music_data

# Web Interface Port (Access via http://<ip-or-localhost>:8085)
PORT=8085

# [OPTIONAL] Local Ollama AI Server for smart playlist curation & Venn overlap
# OLLAMA_HOST=http://192.168.1.50:11434
# OLLAMA_MODEL=qwen3.5:9b
