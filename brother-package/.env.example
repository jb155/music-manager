# ==============================================================================
# MUSIC MANAGER CONFIGURATION
# ==============================================================================

# 1. Docker Image Name
IMAGE_NAME=ghcr.io/jb155/music-manager:latest

# 2. Web UI Port (access the app in your browser at http://localhost:8085 or your NAS IP:8085)
PORT=8085

# 3. Path to your existing Music Library folder on your NAS or PC
# Linux / Synology / OMV / TrueNAS example: /volume1/Music or /srv/storage/Music
# Windows Docker Desktop example: C:/Music or D:/Media/Music
MUSIC_PATH=/path/to/your/Music

# 4. Path to your staging / downloads directory (where SpotDL downloads go before import)
NEW_MUSIC_PATH=/path/to/your/Music_New

# 5. Persistent config directory (stores your personal library.db database)
CONFIG_PATH=./config

# 6. Audio preview cache directory
PREVIEW_PATH=./.music_preview

# 7. (Optional) Ollama Host for AI Music Recommendations
# Leave blank if you do not run a local Ollama AI model
OLLAMA_HOST=
OLLAMA_MODEL=qwen3.5:9b
